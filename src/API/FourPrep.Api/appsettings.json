{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FourPrep.Api"
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Hangfire": {
    "Dashboard": {
      "Enabled": false,
      "Path": "/hangfire",
      "Title": "FourPrep Jobs"
    }
  },
  "Authentication": {
    "Keycloak": {
      "MetadataAddress": "",
      "Audience": "",
      "ValidIssuer": ""
    }
  },
  "Identity": {
    "Keycloak": {
      "BaseUrl": "",
      "Realm": "",
      "ClientId": "",
      "ClientSecret": "",
      "EmailRedirectUrl": ""
    }
  },
  "Storage": {
    "S3": {
      "ServiceUrl": "",
      "Region": "",
      "AccessKey": "",
      "SecretKey": "",
      "DocumentsBucket": "",
      "ForcePathStyle": false
    },
    "ClamAv": {
      "Host": "",
      "Port": 0
    }
  },
  "AllowedHosts": "*"
}
