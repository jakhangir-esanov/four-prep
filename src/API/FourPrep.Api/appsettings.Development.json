{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=fourprep;Username=postgres;Password=postgres;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FourPrep.Api"
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Hangfire": {
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "Title": "FourPrep Jobs"
    }
  },
  "Authentication": {
    "Keycloak": {
      "MetadataAddress": "http://localhost:8080/realms/fourprep/.well-known/openid-configuration",
      "Audience": "fourprep-api",
      "ValidIssuer": "http://localhost:8080/realms/fourprep"
    }
  },
  "Identity": {
    "Keycloak": {
      "BaseUrl": "http://localhost:8080/",
      "Realm": "fourprep",
      "ClientId": "fourprep-api",
      "ClientSecret": "fourprep-dev-secret"
    }
  }
}
